# Database connection string
# Get this from your PostgreSQL server or Supabase/Neon
DATABASE_URL="postgresql://user:password@localhost:5432/syntecxhub_auth?schema=public"

# JWT Configuration
# Generate a secure random string: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# bcrypt rounds (higher = slower but more secure)
BCRYPT_ROUNDS="12"

# App configuration
NODE_ENV="development"
PORT="3000"
